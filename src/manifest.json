{
  "id": "com.deepbrid.syncler.static",
  "name": "Deepbrid",
  "description": "Static Syncler Express package that calls Deepbrid Stremio stream routes directly.",
  "version": 1,
  "type": "express",
  "url": "./express.json",
  "accounts": [
    {
      "alias": "deepbrid",
      "branding": {
        "name": "Deepbrid",
        "website": "https://www.deepbrid.com",
        "logo": "https://www.deepbrid.com/application/default/themes/okagev4/public/img/logo-dark.png"
      },
      "auth": {
        "type": "token",
        "allowedDomains": [
          "deepbrid.com"
        ]
      },
      "verification": {
        "method": "GET",
        "url": "https://www.deepbrid.com/stremio/{managedAccounts.deepbrid.token}/manifest.json",
        "responseType": "json",
        "extract": {
          "name": {
            "type": "jsonpath",
            "value": "$.name"
          }
        }
      }
    }
  ]
}
