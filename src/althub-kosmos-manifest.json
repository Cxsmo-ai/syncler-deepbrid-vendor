{
  "id": "com.deepbrid.syncler.althub.cache",
  "name": "Deepbrid Althub Cache",
  "description": "Static Kosmos provider that searches Althub/Newznab, submits NZB URLs to Deepbrid Usenet, and returns a caching placeholder while links are pending.",
  "version": 1,
  "type": "kosmos",
  "url": "https://raw.githubusercontent.com/Cxsmo-ai/syncler-deepbrid-vendor/v0.2.1/src/althub-kosmos.js",
  "accounts": [
    {
      "alias": "deepbrid",
      "branding": {
        "name": "Deepbrid",
        "website": "https://www.deepbrid.com/aff/go/pickymarker4906",
        "logo": "https://www.deepbrid.com/application/default/themes/okagev4/public/img/logo-dark.png"
      },
      "auth": {
        "type": "token",
        "allowedDomains": [
          "deepbrid.com"
        ],
        "inject": {
          "query": {
            "apikey": "{managedAccounts.deepbrid.token}"
          }
        }
      },
      "verification": {
        "method": "GET",
        "url": "https://www.deepbrid.com/stremio/api/account",
        "responseType": "json",
        "extract": {
          "username": {
            "type": "jsonpath",
            "value": "$.username"
          }
        }
      }
    },
    {
      "alias": "althub",
      "branding": {
        "name": "altHUB",
        "website": "https://althub.co.za",
        "logo": "https://api.althub.co.za/images/banner.jpg"
      },
      "auth": {
        "type": "token",
        "allowedDomains": [
          "api.althub.co.za",
          "althub.co.za"
        ],
        "inject": {
          "query": {
            "apikey": "{managedAccounts.althub.token}"
          }
        }
      },
      "verification": {
        "method": "GET",
        "url": "https://api.althub.co.za/api?t=caps&o=json",
        "responseType": "json",
        "extract": {
          "name": {
            "type": "jsonpath",
            "value": "$.server.@attributes.title"
          }
        }
      }
    }
  ]
}
